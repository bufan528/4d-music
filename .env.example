# ============================================================
# 后端环境变量示例 —— 复制为仓库根目录的 .env 后按需填写
# ============================================================

# LLM 配置（不填则 AI 点评显示「服务未连接」，不影响打分）
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_NAME=

# 防滥用令牌：设置后 /analyze 必须携带 x-api-token 请求头
# 不设置 = 任何人都能调用分析接口并消耗你的 LLM 额度
API_TOKEN=

# 允许跨域的前端域名，多个用逗号分隔
# 不设置 = 允许所有来源（开发方便，生产环境务必设置）
CORS_ORIGINS=

# 服务端口
PORT=8000

# ============================================================
# 前端环境变量 —— 复制为 front/.env.local
# ============================================================

# 开发服务器（vite dev）代理的后端地址
VITE_BACKEND_URL=http://localhost:8000
